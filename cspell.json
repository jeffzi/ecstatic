{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "files": ["**/*.{ts,tsx,mts,cts,md}"],
  "ignorePaths": [
    "node_modules",
    "coverage",
    "dist",
    "package-lock.json",
    "CHANGELOG.md",
    "*.tsbuildinfo",
    ".planning",
    ".research",
    ".claude",
    ".fallow"
  ],
  "words": [
    "codegen",
    "cooldown",
    "cooldowns",
    "despawn",
    "despawned",
    "despawning",
    "despawns",
    "desync",
    "dieable",
    "freelist",
    "multiplicatively",
    "ndebug",
    "nonascii",
    "oxlint",
    "precheck",
    "rebinder",
    "reentrancy",
    "respawn",
    "retarget",
    "retargeted",
    "retargets",
    "spawnable",
    "subtyping",
    "TSTL",
    "ttsc",
    "typechecks",
    "userland"
  ]
}
