import * as ecstatic_internal from "ecstatic/internal";
const DEBUG = typeof NDEBUG === "undefined" || !NDEBUG;
const shapeKey = "c8:Position{1:x=n,1:y=n}c8:Velocity{2:dx=n,2:dy=n}|";
import { createWorld, each, get, register, spawn, type Storage } from "ecstatic";

import { Mover, Position } from "../../schema.js";

interface Game {
  readonly level: { readonly movers: Storage<typeof Mover> };
}

/** Moves every row of a storage reached through a chain of property accesses. */
export function scenario(): unknown {
  const game: Game = { level: { movers: register(createWorld(), Mover) } };
  const ids = [
    spawn(game.level.movers, { Position: { x: 4, y: 0 }, Velocity: { dx: 1, dy: 0 } }),
    spawn(game.level.movers, { Position: { x: 9, y: 0 }, Velocity: { dx: -6, dy: 0 } }),
  ];
  const visited: number[] = [];

  {
      const storage = game.level.movers;
      DEBUG && ecstatic_internal.assertShape(storage, shapeKey);
      const n = storage.n;
      if (n > 0) {
          const PositionRecord = storage.Position, VelocityRecord = storage.Velocity;
          let value;
          for (let i = n - 1; i >= 0; i--) {
              visited.push(storage.entities[i]);
              (value = PositionRecord.x[i], value = value + (VelocityRecord.dx[i]), PositionRecord.x[i] = value);
          }
      }
  }

  return { visited, xs: ids.map((id) => get(game.level.movers, id, Position.x)) };
}
