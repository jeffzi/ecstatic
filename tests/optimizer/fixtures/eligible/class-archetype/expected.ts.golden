import * as ecstatic_internal from "ecstatic/internal";
import { Archetype, createWorld, each, get, register, spawn } from "ecstatic";

import { Position, Velocity } from "../../schema.js";

class Runner extends Archetype([Position, Velocity]) {}

/** Moves every row of a storage registered from a class-form archetype. */
export function scenario(): unknown {
  const world = createWorld();
  const runners = register(world, Runner);
  const ids = [
    spawn(runners, { Position: { x: 0, y: 1 }, Velocity: { dx: 0, dy: 3 } }),
    spawn(runners, { Position: { x: 0, y: 4 }, Velocity: { dx: 0, dy: -2 } }),
  ];
  const visited: number[] = [];

  {
      const storage = runners;
      (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage, "c8:Position{1:x=n,1:y=n}c8:Velocity{2:dx=n,2:dy=n}|");
      const n = storage.n;
      if (n > 0) {
          const PositionRecord = storage.Position, VelocityRecord = storage.Velocity;
          let value;
          for (let i = n - 1; i >= 0; i--) {
              visited.push(storage.entities[i]);
              (value = PositionRecord.y[i], value = value + (VelocityRecord.dy[i]), PositionRecord.y[i] = value);
          }
      }
  }

  return { visited, ys: ids.map((id) => get(runners, id, Position.y)) };
}
