import * as ecstatic_internal from "ecstatic/internal";
import { archetype, component, createWorld, each, get, register, spawn, spawnMany } from "ecstatic";

const Cell = component("HiveCell", { x: 0 });
const Bee = component("HiveBee", { y: 0 });

/**
 * Spawns from the body into a truthfully typed storage of another shape, which leaves the iterated storage's columns
 * in place: every write lands in the iterated storage and every spawned row in the other. Each spawn's target is
 * evaluated once, after the code before the call and before the call's other arguments.
 *
 * @returns Each original row's `x`, how many rows the other storage holds, and the order the body's parts ran in.
 */
export function scenario(): unknown {
  const world = createWorld();
  const cells = register(world, archetype([Cell]));
  const bees = register(world, archetype([Bee]));
  const ids = [spawn(cells, { HiveCell: { x: 1 } }), spawn(cells, { HiveCell: { x: 2 } })];
  let trace = "";

  {
      const storage = cells;
      (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage, "c8:HiveCell{1:x=n}|");
      const n_1 = storage.n;
      if (n_1 > 0) {
          const HiveCellRecord = storage.HiveCell;
          const xColumn = HiveCellRecord.x;
          let target;
          for (let i = n_1 - 1; i >= 0; i--) {
              trace += "b";
              spawn((target = ((trace += "t"), bees), (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(target, "c7:HiveBee{1:y=n}|"), target), ((trace += "v"), { HiveBee: { y: xColumn[i] } }));
              xColumn[i] += 10;
          }
      }
  }
  {
      const storage_1 = cells;
      (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage_1, "c8:HiveCell{1:x=n}|");
      const n_2 = storage_1.n;
      if (n_2 > 0) {
          const HiveCellRecord_1 = storage_1.HiveCell;
          const xColumn_1 = HiveCellRecord_1.x;
          let target_1;
          for (let i_1 = n_2 - 1; i_1 >= 0; i_1--) {
              trace += "B";
              spawnMany((target_1 = ((trace += "T"), bees), (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(target_1, "c7:HiveBee{1:y=n}|"), target_1), ((trace += "N"), 2));
              xColumn_1[i_1] += 100;
          }
      }
  }

  return { xs: ids.map((id) => get(cells, id, Cell.x)), bees: bees.n, trace };
}
