/** Spawns into a truthfully typed storage of another shape, then through a cast that claims that shape for the iterated one. */
export function spawnAfterTruth(): Outcome {
  const { storage, others, ids } = setup();
  const lie = storage as unknown as Storage<typeof OtherShape>;
  return outcome(storage, others, ids, () => {
    {
        const storage_5 = storage;
        (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage_5, "c9:LyingSpot{1:x=n}|");
        const n_5 = storage_5.n;
        if (n_5 > 0) {
            const LyingSpotRecord_4 = storage_5.LyingSpot;
            const xColumn_4 = LyingSpotRecord_4.x;
            let target_4, target_5;
            for (let i_4 = n_5 - 1; i_4 >= 0; i_4--) {
                xColumn_4[i_4] += 100;
                spawn((target_4 = others, (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(target_4, "c10:LyingOther{1:y=n}|"), target_4));
                spawn((target_5 = lie, (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(target_5, "c10:LyingOther{1:y=n}|"), target_5));
                xColumn_4[i_4] += 1000;
            }
        }
    }
  });
}

/** Spawns many rows into a truthfully typed storage of another shape, then through a cast that claims that shape for the iterated one. */
export function spawnManyAfterTruth(): Outcome {
  const { storage, others, ids } = setup();
  const lie = storage as unknown as Storage<typeof OtherShape>;
  return outcome(storage, others, ids, () => {
    {
        const storage_6 = storage;
        (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage_6, "c9:LyingSpot{1:x=n}|");
        const n_6 = storage_6.n;
        if (n_6 > 0) {
            const LyingSpotRecord_5 = storage_6.LyingSpot;
            const xColumn_5 = LyingSpotRecord_5.x;
            let target_6, target_7;
            for (let i_5 = n_6 - 1; i_5 >= 0; i_5--) {
                xColumn_5[i_5] += 100;
                spawnMany((target_6 = others, (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(target_6, "c10:LyingOther{1:y=n}|"), target_6), 2);
                spawnMany((target_7 = lie, (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(target_7, "c10:LyingOther{1:y=n}|"), target_7), 1);
                xColumn_5[i_5] += 1000;
            }
        }
    }
  });
}

/** Spawns through a cast that claims a same-named component with another field for the iterated storage. */
export function spawnThroughTwin(): Outcome {
  const { storage, others, ids } = setup();
  const lie = storage as unknown as Storage<typeof TwinShape>;
  return outcome(storage, others, ids, () => {
    {
        const storage_7 = storage;
        (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage_7, "c9:LyingSpot{1:x=n}|");
        const n_7 = storage_7.n;
        if (n_7 > 0) {
            const LyingSpotRecord_6 = storage_7.LyingSpot;
            const xColumn_6 = LyingSpotRecord_6.x;
            let target_8;
            for (let i_6 = n_7 - 1; i_6 >= 0; i_6--) {
                xColumn_6[i_6] += 100;
                spawn((target_8 = lie, (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(target_8, "c9:LyingSpot{1:z=n}|"), target_8));
                xColumn_6[i_6] += 1000;
            }
        }
    }
  });
}

