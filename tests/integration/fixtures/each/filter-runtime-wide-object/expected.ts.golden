import * as ecstatic_internal from "ecstatic/internal";
var site;
// rewrite-applies: filter-runtime
// rewrite-applies: filter-runtime-mixed
import { archetype, component, createWorld, each, register, spawn, type Storage } from "ecstatic";

const Spot = component("LatchSpot", { x: 0 });
const Bolt = component("LatchBolt");
const Latch = archetype([Spot], [Bolt]);

/**
 * Records the rows one call site visits for a filter typed `object`, which a component array satisfies
 * as well as a filter object.
 *
 * @param storage - The storage of the scenario, iterated through one call site.
 * @param filter - A component array or a filter object.
 * @returns The `x` of each visited row, in visit order.
 */
function visit(storage: Storage<typeof Latch>, filter: object): number[] {
  const seen: number[] = [];
  {
      const storage_1 = storage;
      const filter_1 = filter;
      if (typeof filter_1 !== "object" || filter_1 === null)
          ecstatic_internal.throwInvalidEachArguments();
      (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage_1, "c9:LatchSpot{1:x=n}|c9:LatchBolt{}");
      const array = ecstatic_internal.isArray(filter_1);
      const all = (array ? filter_1 : filter_1.all), any = (array ? void 0 : filter_1.any), none_1 = (array ? void 0 : filter_1.none);
      site ??= { s: void 0, f: void 0, all: void 0, any: void 0, none: void 0, allIds: void 0, anyIds: void 0, noneIds: void 0, m: void 0 };
      let hit = site.s === storage_1 && site.f === filter_1 && site.all === all && site.any === any && site.none === none_1;
      if (hit && all != null) {
          const ids = site.allIds;
          hit = all.length === ids.length;
          for (let k = 0; hit && k < ids.length; k++)
              hit = all[k] === ids[k];
      }
      if (hit && any != null) {
          const ids = site.anyIds;
          hit = any.length === ids.length;
          for (let k = 0; hit && k < ids.length; k++)
              hit = any[k] === ids[k];
      }
      if (hit && none_1 != null) {
          const ids = site.noneIds;
          hit = none_1.length === ids.length;
          for (let k = 0; hit && k < ids.length; k++)
              hit = none_1[k] === ids[k];
      }
      let matcher = site.m;
      if (!hit) {
          const allIds = all ?? [], anyIds = any ?? [], noneIds = none_1 ?? [];
          matcher = ecstatic_internal.resolveFilterMasks(storage_1, allIds, anyIds, noneIds);
          site.s = storage_1;
          site.f = filter_1;
          site.all = all;
          site.any = any;
          site.none = none_1;
          site.allIds = [...allIds];
          site.anyIds = [...anyIds];
          site.noneIds = [...noneIds];
          site.m = matcher;
      }
      if (matcher !== false) {
          const n = storage_1.n;
          if (n > 0) {
              const LatchSpotRecord = storage_1.LatchSpot;
              if (matcher.allMask === 0 && matcher.anyMask === 0 && matcher.noneMask === 0) {
                  for (let i = n - 1; i >= 0; i--) {
                      seen.push(LatchSpotRecord.x[i]);
                  }
              }
              else {
                  for (let i = n - 1; i >= 0; i--) {
                      if (matcher.matched[i] !== 0) {
                          seen.push(LatchSpotRecord.x[i]);
                      }
                  }
              }
          }
      }
  }
  return seen;
