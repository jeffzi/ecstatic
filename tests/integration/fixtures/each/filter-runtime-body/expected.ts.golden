import * as ecstatic_internal from "ecstatic/internal";
var site;
// rewrite-applies: mode-realloc-safe
// rewrite-applies: filter-runtime
// rewrite-applies: filter-runtime-object
// rewrite-applies: read-optional-field
// rewrite-applies: write-required-field
// rewrite-applies: presence-optional
// rewrite-applies: return-void
// rewrite-applies: return-labeled
// rewrite-applies: var-to-let
// rewrite-applies: user-label
import {
  archetype,
  component,
  createWorld,
  each,
  type EachFilter,
  get,
  register,
  spawn,
} from "ecstatic";

const Spot = component("RelaySpot", { x: 0, total: 0 });
const Coil = component("RelayCoil", { turns: 0 });
const Fuse = component("RelayFuse");
const Relay = archetype([Spot], [Coil, Fuse]);

/**
 * Runs one body through the unfiltered loop, for a filter every row satisfies, and through the filtered loop, for
 * one only some rows satisfy: a labeled loop, a `var` that is its own binding on every row (read later through a closure), a
 * `return` that ends the row from inside a loop and from the body, a presence test, and reads and writes of the view's
 * fields behave alike in both.
 *
 * @returns What each row ran, in visit order, each row's tag as its closure reads it after the calls, and each row's
 * final total.
 */
export function scenario(): unknown {
  const storage = register(createWorld(), Relay);
  const ids = [
    spawn(storage, { RelaySpot: { x: 1 }, RelayCoil: { turns: 3 } }),
    spawn(storage, { RelaySpot: { x: 2 }, RelayFuse: true }),
    spawn(storage, { RelaySpot: { x: 3 }, RelayCoil: { turns: 2 }, RelayFuse: true }),
  ];
  const every: EachFilter = { all: [Spot] };
  const wired: EachFilter = { any: [Coil, Fuse] };
  const seen: string[] = [];
  const tags: (() => string)[] = [];

  for (const filter of [every, wired, every]) {
    seen.push("call");
    // fallow-ignore-next-line complexity -- the callback packs the forms under test into one body
    {
        const storage_1 = storage;
        const filter_1 = filter;
        if (typeof filter_1 !== "object" || filter_1 === null)
            ecstatic_internal.throwInvalidEachArguments();
        (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage_1, "c9:RelaySpot{5:total=n,1:x=n}|c9:RelayCoil{5:turns=n}c9:RelayFuse{}");
        const all_1 = filter_1.all, any_1 = filter_1.any, none = filter_1.none;
        site ??= { s: void 0, f: void 0, all: void 0, any: void 0, none: void 0, allIds: void 0, anyIds: void 0, noneIds: void 0, m: void 0 };
        let hit = site.s === storage_1 && site.f === filter_1 && site.all === all_1 && site.any === any_1 && site.none === none;
        if (hit && all_1 != null) {
            const ids_1 = site.allIds;
            hit = all_1.length === ids_1.length;
            for (let k = 0; hit && k < ids_1.length; k++)
                hit = all_1[k] === ids_1[k];
        }
        if (hit && any_1 != null) {
            const ids_1 = site.anyIds;
            hit = any_1.length === ids_1.length;
            for (let k = 0; hit && k < ids_1.length; k++)
                hit = any_1[k] === ids_1[k];
        }
        if (hit && none != null) {
            const ids_1 = site.noneIds;
            hit = none.length === ids_1.length;
            for (let k = 0; hit && k < ids_1.length; k++)
                hit = none[k] === ids_1[k];
        }
        let matcher = site.m;
        if (!hit) {
            const allIds = all_1 ?? [], anyIds = any_1 ?? [], noneIds = none ?? [];
            matcher = ecstatic_internal.resolveFilterMasks(storage_1, allIds, anyIds, noneIds);
            site.s = storage_1;
            site.f = filter_1;
            site.all = all_1;
            site.any = any_1;
            site.none = none;
            site.allIds = [...allIds];
            site.anyIds = [...anyIds];
            site.noneIds = [...noneIds];
            site.m = matcher;
        }
        if (matcher !== false) {
            const n = storage_1.n;
            if (n > 0) {
                const RelaySpotRecord = storage_1.RelaySpot, RelayCoilRecord = storage_1.RelayCoil;
                let value, value_1;
                if (matcher.allMask === 0 && matcher.anyMask === 0 && matcher.noneMask === 0) {
                    row: for (let i = n - 1; i >= 0; i--) {
                        let tag;
                        tag = `${RelaySpotRecord.x[i]}`;
                        tags.push(() => tag);
                        if ((!((storage_1.mask[i] & 1) !== 0))) {
                            seen.push(`${tag}:bare`);
                            continue;
                        }
                        winding: for (let turn = 0; turn < 4; turn++) {
                            if (turn === (((storage_1.mask[i] & 1) !== 0) ? RelayCoilRecord.turns : void 0)[i])
                                break winding;
                            if (((storage_1.mask[i] & 2) !== 0) && turn === 1)
                                continue row;
                            tag += `.${turn}`;
                        }
                        (value = RelaySpotRecord.total[i] + (((storage_1.mask[i] & 1) !== 0) ? RelayCoilRecord.turns : void 0)[i], RelaySpotRecord.total[i] = value);
                        seen.push(tag);
                    }
                }
                else {
                    row: for (let i = n - 1; i >= 0; i--) {
                        if (matcher.matched[i] !== 0) {
                            let tag;
                            tag = `${RelaySpotRecord.x[i]}`;
                            tags.push(() => tag);
                            if ((!((storage_1.mask[i] & 1) !== 0))) {
                                seen.push(`${tag}:bare`);
                                continue;
                            }
                            winding: for (let turn = 0; turn < 4; turn++) {
                                if (turn === (((storage_1.mask[i] & 1) !== 0) ? RelayCoilRecord.turns : void 0)[i])
                                    break winding;
                                if (((storage_1.mask[i] & 2) !== 0) && turn === 1)
                                    continue row;
                                tag += `.${turn}`;
                            }
                            (value_1 = RelaySpotRecord.total[i] + (((storage_1.mask[i] & 1) !== 0) ? RelayCoilRecord.turns : void 0)[i], RelaySpotRecord.total[i] = value_1);
                            seen.push(tag);
                        }
                    }
                }
            }
        }
    }
  }

  return {
    seen,
    tags: tags.map((read) => read()),
    totals: ids.map((id) => get(storage, id, Spot.total)),
  };
}
