import * as ecstatic_internal from "ecstatic/internal";
import { createWorld, each, get, register, spawn, type Storage } from "ecstatic";

import { Mover, Position } from "../../schema.js";

interface Level {
  readonly movers: Storage<typeof Mover>;
}

function moversOf(level: Level): Storage<typeof Mover> {
  return level.movers;
}

/** Moves every row of a storage returned by a function call. */
export function scenario(): unknown {
  const level: Level = { movers: register(createWorld(), Mover) };
  const ids = [
    spawn(level.movers, { Position: { x: 6, y: 0 }, Velocity: { dx: 3, dy: 0 } }),
    spawn(level.movers, { Position: { x: 1, y: 0 }, Velocity: { dx: 5, dy: 0 } }),
  ];
  const visited: number[] = [];

  {
      const storage = moversOf(level);
      (typeof NDEBUG === "undefined" || !NDEBUG) && ecstatic_internal.assertShape(storage, "c8:Position{1:x=n,1:y=n}c8:Velocity{2:dx=n,2:dy=n}|");
      const n = storage.n;
      if (n > 0) {
          const PositionRecord = storage.Position, VelocityRecord = storage.Velocity;
          let value;
          for (let i = n - 1; i >= 0; i--) {
              visited.push(storage.entities[i]);
              (value = PositionRecord.x[i], value = value + (VelocityRecord.dx[i]), PositionRecord.x[i] = value);
          }
      }
  }

  return { visited, xs: ids.map((id) => get(level.movers, id, Position.x)) };
}
