{
  "compilerOptions": {
    "target": "ES2024",
    "module": "nodenext",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "nodenext",
    "noEmit": true,
    "composite": true
  },
  "include": ["examples/**/*.ts"],
  "references": [{ "path": "./tsconfig.build.json" }]
}
