{
  "name": "ecstatic",
  "version": "0.5.0",
  "description": "Statically typed archetype-based ECS",
  "keywords": [
    "ecs",
    "entity-component-system",
    "gamedev",
    "typescript"
  ],
  "license": "MIT",
  "author": "jeffzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffzi/ecstatic.git"
  },
  "files": [
    "dist",
    "src/ecstatic"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./vite": {
      "types": "./dist/plugin/vite.d.ts",
      "default": "./dist/plugin/vite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build-plugin.json",
    "check": "lefthook run check && npm run check:type && npm run check:version && npm run check:alloc",
    "check:alloc": "npm run -s build && tsx --expose-gc benchmarks/alloc/gate.ts",
    "check:mutation": "stryker run stryker.config.ts",
    "check:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "check:security": "fallow security",
    "check:type": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.build-plugin.json --noEmit && tsc -p examples/tsconfig.json --noEmit && tsc -p benchmarks/tsconfig.json --noEmit",
    "check:version": "tsx scripts/sync-version.ts --check",
    "examples": "npm run build && tsx examples/basics.ts && tsx examples/iteration.ts && tsx examples/component-sets.ts && tsx examples/relationships.ts && tsx examples/resources.ts && tsx examples/game-loop.ts && tsx examples/optionals.ts",
    "fix": "lefthook run check --command lint --command md --command fmt && fallow fix --yes --no-create-config",
    "prepare": "test -d .git && lefthook install || true",
    "prepublishOnly": "npm test && npm run check",
    "test": "vitest run --coverage",
    "test:types": "vitest run --project types",
    "version": "tsx scripts/sync-version.ts && git add src/ecstatic/version.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^4.1.0",
    "cspell": "^10.4.0",
    "esbuild": "^0.28.2",
    "fallow": "^3.34.1",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.23.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "tinybench": "^6.2.2",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-dev.20261020.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "typescript": "7.1.0-dev.20261020.3",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "^1.9.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
